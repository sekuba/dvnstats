{
  "name": "envio-indexer",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "tsc --clean",
    "build": "tsc --noEmit",
    "watch": "tsc --watch",
    "codegen": "envio codegen",
    "start": "./run-indexer.sh",
    "stop": "./stop-indexer.sh",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "db:indexes": "docker exec -i dvnstats-postgres psql -U postgres -d envio-dev -v ON_ERROR_STOP=1 -f - < scripts/indexes.sql",
    "test": "pnpm build",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "stats:precompute": "node scripts/precomputePacketStats.js",
    "stats:batch": "node scripts/precomputePacketStats.js --batch",
    "stats:incremental": "node scripts/precomputePacketStats.js --incremental",
    "stats:batch-incremental": "node scripts/precomputePacketStats.js --batch --incremental",
    "indexer:status": "node scripts/indexerStatus.js",
    "registry:build": "node scripts/buildDashboardRegistry.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.1",
    "@types/node": "25.6.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "envio": "3.8.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
